<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" fill="none">
  <defs>
    <linearGradient id="boxGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="50%" stop-color="#FBFBFA"/>
      <stop offset="100%" stop-color="#F2F3EF"/>
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#285A52"/>
      <stop offset="100%" stop-color="#3C7D73"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="130%">
      <feDropShadow dx="0" dy="25" stdDeviation="35" flood-color="#0B131D" flood-opacity="0.12"/>
      <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#0B131D" flood-opacity="0.08"/>
    </filter>
  </defs>

  <!-- Background Canvas -->
  <rect width="800" height="1000" fill="#FAF9F5" rx="12"/>

  <!-- Product Box 3D/Front Facing Packshot -->
  <g filter="url(#shadow)" transform="translate(180, 140)">
    <!-- Main Box Body -->
    <rect width="440" height="680" rx="8" fill="url(#boxGrad)" stroke="#E5E7EB" stroke-width="1.5"/>

    <!-- Top Accent Bar -->
    <path d="M 0 8 Q 0 0 8 0 L 432 0 Q 440 0 440 8 L 440 16 L 0 16 Z" fill="url(#accentGrad)"/>

    <!-- Onecore Brand Logo Top -->
    <g transform="translate(48, 56)">
      <rect width="24" height="24" rx="3" fill="#0B131D"/>
      <circle cx="12" cy="12" r="5" fill="#FAF9F5"/>
      <circle cx="12" cy="12" r="2" fill="#285A52"/>
      <text x="36" y="17" font-family="'Manrope', sans-serif" font-size="14" font-weight="700" letter-spacing="0.15em" fill="#0B131D">ONECORE</text>
      <text x="36" y="27" font-family="'Manrope', sans-serif" font-size="8" font-weight="600" letter-spacing="0.2em" fill="#285A52">PHARMA</text>
    </g>

    <!-- Category Tag -->
    <g transform="translate(48, 120)">
      <rect width="130" height="24" rx="12" fill="#E9F1EF"/>
      <text x="14" y="16" font-family="'Manrope', sans-serif" font-size="10" font-weight="700" letter-spacing="0.15em" fill="#285A52">ORTHOPAEDICS</text>
    </g>

    <!-- Product Main Brand Name -->
    <text x="48" y="220" font-family="'Manrope', sans-serif" font-size="52" font-weight="300" letter-spacing="-0.03em" fill="#0B131D">One<tspan font-weight="700">FLEXO</tspan></text>
    <text x="48" y="252" font-family="'Manrope', sans-serif" font-size="13" font-weight="500" letter-spacing="0.04em" fill="#526071">Specialised Joint Health Formulation</text>

    <!-- Thin Divider -->
    <line x1="48" y1="280" x2="392" y2="280" stroke="#E5E8EB" stroke-width="1"/>

    <!-- Active Ingredient Formulation Highlights -->
    <g transform="translate(48, 310)">
      <!-- Ingredient 1 -->
      <g transform="translate(0, 0)">
        <circle cx="6" cy="6" r="3" fill="#285A52"/>
        <text x="18" y="10" font-family="'Manrope', sans-serif" font-size="14" font-weight="600" fill="#111827">Aflapin®</text>
        <text x="240" y="10" font-family="'Manrope', monospace" font-size="13" font-weight="700" fill="#285A52" text-anchor="end">100 mg</text>
      </g>
      <line x1="0" y1="24" x2="344" y2="24" stroke="#F0F2F5" stroke-width="1"/>

      <!-- Ingredient 2 -->
      <g transform="translate(0, 42)">
        <circle cx="6" cy="6" r="3" fill="#285A52"/>
        <text x="18" y="10" font-family="'Manrope', sans-serif" font-size="14" font-weight="600" fill="#111827">Native Type II Collagen</text>
        <text x="240" y="10" font-family="'Manrope', monospace" font-size="13" font-weight="700" fill="#285A52" text-anchor="end">40 mg</text>
      </g>
      <line x1="0" y1="66" x2="344" y2="66" stroke="#F0F2F5" stroke-width="1"/>

      <!-- Ingredient 3 -->
      <g transform="translate(0, 84)">
        <circle cx="6" cy="6" r="3" fill="#285A52"/>
        <text x="18" y="10" font-family="'Manrope', sans-serif" font-size="14" font-weight="600" fill="#111827">Mobilee®</text>
        <text x="240" y="10" font-family="'Manrope', monospace" font-size="13" font-weight="700" fill="#285A52" text-anchor="end">40 mg</text>
      </g>
    </g>

    <!-- Bottom Presentation Area -->
    <g transform="translate(48, 540)">
      <rect width="344" height="88" rx="6" fill="#F8F9FA" stroke="#E5E7EB" stroke-width="1"/>
      <text x="20" y="32" font-family="'Manrope', sans-serif" font-size="11" font-weight="700" letter-spacing="0.1em" fill="#0B131D">TRIPLE ACTION JOINT SUPPORT</text>
      <text x="20" y="52" font-family="'Manrope', sans-serif" font-size="11" font-weight="400" fill="#526071">Boswellia Extract + Undenatured Collagen + HA Matrix</text>
      <text x="20" y="72" font-family="'Manrope', monospace" font-size="10" font-weight="500" fill="#8A96A6">DIETARY SUPPLEMENT / CAPSULES</text>
    </g>
  </g>

  <!-- Understated Ground Reflection/Ambient Base -->
  <ellipse cx="400" cy="850" rx="200" ry="12" fill="#0B131D" fill-opacity="0.05"/>
</svg>
